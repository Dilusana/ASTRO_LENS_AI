# AstroLens X - Backend Environment Configuration
# Add your official Anthropic Claude API Key below:
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Configurable Claude model name (e.g. claude-3-5-sonnet-20241022 or claude-3-7-sonnet-20250219 or claude-3-5-haiku-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022
