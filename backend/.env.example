# AstroLens X - Backend Environment Configuration Template
# Copy this file to .env and insert your official Anthropic Claude API Key:
ANTHROPIC_API_KEY=

# Configurable Claude model name (e.g. claude-3-5-sonnet-latest, claude-3-7-sonnet-20250219, or claude-3-5-haiku-latest)
CLAUDE_MODEL=claude-3-5-sonnet-latest
